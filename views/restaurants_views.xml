<odoo>
    <!-- Vista de llista -->
    <record id="view_restaurant_tree" model="ir.ui.view">
        <field name="name">zoo.restaurant.tree</field>
        <field name="model">zoo.restaurant</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="zoo_id"/>
                <field name="capacity"/>
                <field name="restaurant_type"/>
            </tree>
        </field>
    </record>

    <!-- Vista de formulari -->
    <record id="view_restaurant_form" model="ir.ui.view">
        <field name="name">zoo.restaurant.form</field>
        <field name="model">zoo.restaurant</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="zoo_id"/>
                        <field name="capacity"/>
                        <field name="restaurant_type"/>
                    </group>
                    <group>
                        <field name="services"/>
                        <field name="address"/>
                    </group>
                    <group>
                        <field name="notes"/>
                        <field name="image" widget="image"/>
                    </group>
                    <notebook>
                        <page string="Tags">
                            <field name="tags_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acció -->
    <record id="action_restaurant" model="ir.actions.act_window">
        <field name="name">Restaurants</field>
        <field name="res_model">zoo.restaurant</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
