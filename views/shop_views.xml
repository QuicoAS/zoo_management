<odoo>
    <!-- Vista de llista -->
    <record id="view_shop_tree" model="ir.ui.view">
        <field name="name">zoo.shop.tree</field>
        <field name="model">zoo.shop</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="zoo_id"/>
                <field name="shop_type"/>
                <field name="size"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Vista de formulari -->
    <record id="view_shop_form" model="ir.ui.view">
        <field name="name">zoo.shop.form</field>
        <field name="model">zoo.shop</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="zoo_id"/>
                        <field name="shop_type"/>
                        <field name="size"/>
                    </group>
                    <group>
                        <field name="notes"/>
                        <field name="image" widget="image"/>
                    </group>
                    <group>
                        <field name="active"/>
                        <field name="total_capacity"/>
                    </group>
                    <notebook>
                        <page string="Tags">
                            <field name="tags_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acció -->
    <record id="action_shop" model="ir.actions.act_window">
        <field name="name">Botigues</field>
        <field name="res_model">zoo.shop</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>