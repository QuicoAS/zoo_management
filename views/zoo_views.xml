<odoo>
    <!-- Vista de llista per a Zoològics -->
    <record id="view_zoo_tree" model="ir.ui.view">
        <field name="name">zoo.management.tree</field>
        <field name="model">zoo.management</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="state_id"/>
                <field name="size"/>
                <field name="animal_count"/>
                <field name="species_count"/>
            </tree>
        </field>
    </record>

    <!-- Vista de formulari per a Zoològics -->
    <record id="view_zoo_form" model="ir.ui.view">
        <field name="name">zoo.management.form</field>
        <field name="model">zoo.management</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="city"/>
                        <field name="country_id"/>
                        <field name="state_id"/>
                        <field name="size"/>
                    </group>
                    <group>
                        <field name="animal_count"/>
                        <field name="species_count"/>
                        <field name="notes"/>
                        <field name="image" widget="image"/>
                    </group>
                    <notebook>
                        <page string="Infraestructura">
                            <group>
                                <field name="restaurant"/>
                                <field name="parking_capacity"/>
                                <field name="shop"/>
                                <field name="cafeteria"/>
                                <field name="ticket_price"/>
                            </group>
                        </page>
                        <page string="Tags">
                            <field name="tags_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acció per mostrar el zoològic -->
    <record id="action_zoo" model="ir.actions.act_window">
        <field name="name">Zoològics</field>
        <field name="res_model">zoo.management</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
