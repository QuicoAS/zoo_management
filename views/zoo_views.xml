<odoo>
    <!-- Vista de llista -->
    <record id="view_zoo_tree" model="ir.ui.view">
        <field name="name">zoo.management.tree</field>
        <field name="model">zoo.management</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="city"/>
                <field name="country"/>
                <field name="size"/>
            </tree>
        </field>
    </record>

    <!-- Vista de formulari -->
    <record id="view_zoo_form" model="ir.ui.view">
        <field name="name">zoo.management.form</field>
        <field name="model">zoo.management</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="city"/>
                        <field name="country"/>
                        <field name="size"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acció per mostrar les vistes -->
    <record id="action_zoo_management" model="ir.actions.act_window">
        <field name="name">Zoològics</field>
        <field name="res_model">zoo.management</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_zoo_management_root" name="Zoo Management" sequence="1"/>
    <menuitem id="menu_zoo_management" name="Zoològics" parent="menu_zoo_management_root" action="action_zoo_management" sequence="10"/>
</odoo>
